
/**
 * @file Firestore Security Rules
 * @description This ruleset enforces a strict user-ownership model for private user data while allowing public access to courses and blog posts.
 * It also defines roles for 'admin' and 'developer' with broader access permissions for management and community features.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profiles and roles.
 * - /courses/{courseId}: Stores course information.
 * ... and other collections as defined in backend.json
 *
 * Key Security Decisions:
 * - User data is strictly controlled; users can manage their own data.
 * - Admins and Developers can read all user data for management purposes.
 * - Public content like courses and blog posts is readable by anyone.
 * - Enrolled users can participate in course-specific features like forums and reviews.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for role-based access control
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }
    
    function getUserRole(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data.role;
    }

    function isAdmin() {
      return getUserRole(request.auth.uid) == 'admin';
    }

    function isDeveloper() {
        return getUserRole(request.auth.uid) == 'developer';
    }
    
    function isTeacher() {
      return getUserRole(request.auth.uid) == 'teacher';
    }

    function isAdminOrDeveloper() {
        return isAdmin() || isDeveloper();
    }
    
    function isSupportStaff() {
        return isAdmin() || isDeveloper() || isTeacher();
    }
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isEnrolled(courseId) {
      // Check if an enrollment document exists for the user and course.
      // This is efficient because it checks for a document with a known path.
      return exists(/databases/$(database)/documents/users/$(request.auth.uid)/enrollments/$(courseId));
    }
    
    /**
     * @description Rules for the 'users' collection.
     * Allows users to manage their own profile.
     * Admins/developers can read any profile and update specific fields like 'role'.
     */
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdminOrDeveloper();
      allow list: if isAdminOrDeveloper();
      allow create: if isOwner(userId) && request.resource.data.uid == userId;
      // Allow user to update their own profile, and admins to update specific fields.
      allow update: if isOwner(userId) || (isAdminOrDeveloper() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'displayName', 'photoURL', 'lastLogin', 'hasCompletedOnboarding', 'achievements']));
      allow delete: if isOwner(userId) || isAdminOrDeveloper();
    }

    /**
     * @description Publicly readable course information.
     * Write access is restricted to support staff.
     */
    match /courses/{courseId} {
      allow get, list: if true;
      allow write: if isSupportStaff(); 

      /**
       * @description Course-specific forums.
       * Users enrolled in the course can read and create posts. Post owners and support staff can delete.
       */
      match /forum_posts/{postId} {
        allow read, list: if isEnrolled(courseId);
        allow create: if isEnrolled(courseId) && request.resource.data.authorId == request.auth.uid;
        allow update: if request.resource.data.authorId == request.auth.uid;
        allow delete: if resource.data.authorId == request.auth.uid || isSupportStaff();

        /**
         * @description Replies within a forum post.
         * Enrolled users can read and create replies. Reply owners and support staff can delete.
         */
        match /replies/{replyId} {
          allow read, list: if isEnrolled(courseId);
          allow create: if isEnrolled(courseId) && request.resource.data.authorId == request.auth.uid;
          allow update: if request.resource.data.authorId == request.auth.uid;
          allow delete: if resource.data.authorId == request.auth.uid || isSupportStaff();
        }
      }
      
      /**
       * @description Course reviews.
       * Enrolled users can create one review (by using their UID as the doc ID). Anyone can read reviews.
       */
      match /reviews/{reviewId} {
        allow get, list: if true;
        allow create: if isEnrolled(courseId) && request.resource.data.userId == request.auth.uid && reviewId == request.auth.uid;
        allow update, delete: if resource.data.userId == request.auth.uid;
      }
      
       /**
       * @description Publicly readable practice tests.
       * Write access restricted to support staff.
       */
      match /practice_tests/{practiceTestId} {
        allow get, list: if true;
        allow write: if isSupportStaff();
        
        /**
         * @description Questions are readable by users enrolled in the course.
         */
        match /questions/{questionId} {
          allow get, list: if isEnrolled(courseId);
          allow write: if isSupportStaff(); 
        }
      }
    }

    /**
     * @description User-specific study plans. Only accessible by the owner.
     */
    match /users/{userId}/study_plans/{studyPlanId} {
      allow read, write: if isOwner(userId);
    }

    /**
     * @description User-specific enrollment records.
     * Only accessible by the owner. Stored with a known ID (courseId) for easy checking.
     */
    match /users/{userId}/enrollments/{enrollmentId} {
      allow read, write: if isOwner(userId);
    }

    /**
     * @description Course resources are readable by any user enrolled in the course.
     * Write access is restricted to support staff.
     */
    match /resources/{resourceId} {
      allow get, list: if isAuthenticated() && isEnrolled(resource.data.courseId);
      allow write: if isSupportStaff(); 
    }

    /**
     * @description Publicly readable blog posts.
     * Write access restricted to support staff.
     */
    match /blog_posts/{blogPostId} {
      allow get, list: if true;
      allow write: if isSupportStaff(); 
    }

    /**
     * @description Payment records. Read-only for admins.
     * Write access is handled server-side.
     */
    match /payments/{paymentId} {
      allow get, list: if isSupportStaff();
      allow write: if false; // Deny all client-side writes
    }

    /**
     * @description User-specific test results. Only accessible by the owner.
     */
    match /users/{userId}/test_results/{userTestResultId} {
      allow read, write: if isOwner(userId);
    }
    
    /**
     * @description Support chat threads.
     * Users can manage their own thread. Support staff can access all threads.
     */
    match /support_chats/{userId} {
      allow get: if isOwner(userId) || isSupportStaff();
      allow list: if isSupportStaff();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isSupportStaff();

      /**
       * @description Messages within a support chat.
       * Users can write to their own thread. Support staff can write to any thread.
       */
      match /messages/{messageId} {
        allow read, list: if isOwner(userId) || isSupportStaff();
        allow create: if (isOwner(userId) && request.resource.data.senderId == userId) || isSupportStaff();
      }
    }

    /**
     * @description Badges for gamification. Publicly readable.
     * Write access is restricted to admins/developers.
     */
    match /badges/{badgeId} {
      allow get, list: if true;
      allow write: if isAdminOrDeveloper();
    }
  }
}
