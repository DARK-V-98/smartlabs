
/**
 * @file Firestore Security Rules
 * @description This ruleset enforces a strict user-ownership model for private user data while allowing public access to courses and blog posts.
 * It also defines roles for 'admin' and 'developer' with broader access permissions.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profiles and roles.
 * - /courses/{courseId}: Stores course information.
 * - /users/{userId}/study_plans/{studyPlanId}: Stores user-specific study plans.
 * ... and other collections as defined in backend.json
 *
 * Key Security Decisions:
 * - User data is strictly controlled; users can manage their own data.
 * - Admins and Developers can read all user data for management purposes.
 * - Public content like courses and blog posts is readable by anyone.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for role-based access control
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }
    
    function getUserRole(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data.role;
    }

    function isAdmin() {
      return getUserRole(request.auth.uid) == 'admin';
    }

    function isDeveloper() {
        return getUserRole(request.auth.uid) == 'developer';
    }

    function isAdminOrDeveloper() {
        return isAdmin() || isDeveloper();
    }
    
    function isAuthenticated() {
      return request.auth != null;
    }

    /**
     * @description Rules for the 'users' collection.
     * Allows users to manage their own profile.
     * Allows admins/developers to read any user profile and update roles.
     */
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdminOrDeveloper();
      allow list: if isAdminOrDeveloper();
      allow create: if isOwner(userId) && request.resource.data.uid == userId;
      allow update: if (isExistingOwner(userId) && request.resource.data.uid == resource.data.uid) || 
                       (isAdminOrDeveloper() && request.resource.data.keys().hasOnly(['role', 'lastLogin', 'displayName', 'photoURL']));
      allow delete: if isExistingOwner(userId) || isAdminOrDeveloper();
    }

    /**
     * @description Publicly readable course information.
     * Write access is restricted (e.g., to admins, not implemented here).
     */
    match /courses/{courseId} {
      allow get: if true;
      allow list: if true;
      allow write: if false; // TODO: Add admin role check
    }

    /**
     * @description User-specific study plans. Only accessible by the owner.
     */
    match /users/{userId}/study_plans/{studyPlanId} {
      allow read, write: if isOwner(userId);
    }

    /**
     * @description User-specific enrollment records. Only accessible by the owner.
     */
    match /users/{userId}/enrollments/{enrollmentId} {
      allow read, write: if isOwner(userId);
    }

    /**
     * @description Course resources are readable by any authenticated user.
     */
    match /resources/{resourceId} {
      allow get, list: if isAuthenticated();
      allow write: if false; // TODO: Add admin role check
    }

    /**
     * @description Publicly readable blog posts.
     */
    match /blog_posts/{blogPostId} {
      allow get, list: if true;
      allow write: if false; // TODO: Add admin/author role check
    }

    /**
     * @description Publicly readable practice tests.
     */
    match /courses/{courseId}/practice_tests/{practiceTestId} {
      allow get, list: if true;
      allow write: if false; // TODO: Add admin role check
      
      /**
       * @description Publicly readable questions within a practice test.
       */
      match /questions/{questionId} {
        allow get, list: if true;
        allow write: if false; // TODO: Add admin role check
      }
    }

    /**
     * @description User-specific test results. Only accessible by the owner.
     */
    match /users/{userId}/test_results/{userTestResultId} {
      allow read, write: if isOwner(userId);
    }
  }
}
